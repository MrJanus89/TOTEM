#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define DIR 1
#define NUM 2
#define FUN 3

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
	behaviors {
        AS: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

		HRM_L: homerow_left {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			bindings = <&kp>, <&kp>;

			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			hold-trigger-on-release;
		};

		HRM_R: homerow_right {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			bindings = <&kp>, <&kp>;

			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			hold-trigger-on-release;
		};

		TD_RAlt_RCTRL: td_ralt_rctrl {
			compatible = "zmk,behavior-tap-dance";
			#binding-cells = <0>;
			bindings = <&kp RALT>, <&kp RCTRL>;
			tapping-term-ms = <180>;
		};

        TD_Right: td_right {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp END>;
            tapping-term-ms = <180>;
        };

        TD_Left: td_left {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp HOME>;
            tapping-term-ms = <180>;
        };

        TD_Up: td_up {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp PAGE_UP>;
            tapping-term-ms = <180>;
        };

        TD_Down: td_down {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&kp PAGE_DOWN>;
            tapping-term-ms = <180>;
        };
        
	combos {
        compatible = "zmk,combos";

        combo_LBRK {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <8 9>;
            bindings = <&kp LBKT>;
            layers = <BASE>;
        };

        combo_RBRK {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <9 10>;
            bindings = <&kp RBKT>;
            layers = <BASE>;
        };

        combo_Tab {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <25 26>;
            bindings = <&kp TAB>;
            layers = <BASE>;
        };
		
        combo_cut {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <19 20>;
            bindings = <&kp LC(X)>;
            layers = <BASE>;
		};
		
        combo_copy {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <31 32>;
            bindings = <&kp LC(C)>;
            layers = <BASE>;
        };

        combo_paste {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <43 44>;
            bindings = <&kp LC(V)>;
            layers = <BASE>;
		};
		
        combo_undo {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <32 33>;
            bindings = <&kp LC(Z)>;
            layers = <BASE>;
		};
        
		combo_redo {
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
            key-positions = <20 21>;
            bindings = <&kp LC(Y)>;
            layers = <BASE>;
        };
    };
        keymap {
                compatible = "zmk,keymap";
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

                base_layer {
					bindings = <
													&kp Q       	&kp W       		&kp E       		&kp R       		&kp T           	&kp Y       		&kp U       		&kp I       			&kp O       			&kp P
													&HRM_L LWIN A	&HRM_L LSHIFT S		&HRM_L LCTRL  D 	&HRM_L LALT   F		&kp G           	&kp H  				&HRM_R LALT   J		&HRM_R LCTRL  K			&HRM_R LSHIFT L 		&AS COLON SEMICOLON
								&AS TILDE GRAVE   	&kp Z       	&kp X       		&kp C       		&kp V       		&kp B           	&kp N       		&kp M       		&AS LESS_THAN COMMA  	&AS GREATER_THAN PERIOD	&AS QUESTION SLASH		&AS DOUBLE_QUOTES SQT
																	&TD_RAlt_RCTRL  	&lt 2 SPACE		  	&lt 1 DEL			&lt 3 BACKSPACE		&AS LS(ENTER) ENTER	&AS PIPE BACKSLASH
                        >;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

                dir_layer {
					bindings = <
											&trans &trans &trans &trans &trans    &trans  	&trans 		&TD_Up 		&trans 		  &trans
											&trans &trans &trans &trans &trans    &trans  	&TD_Left 	&TD_Down 	&TD_Right	  &trans 
								&trans      &trans &trans &trans &trans &trans    &trans  	&trans 		&trans 		&trans 		  &trans   &trans         
																	&trans &trans &trans	&kp ESC 	&trans 		&trans
                        >;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

                num_layer {
					bindings = <
											&trans 	&trans 	&trans 	&trans &trans    	&kp SLASH 					&AS AMPERSAND NUMBER_7 	 	&AS ASTERISK NUMBER_8		&AS LEFT_PARENTHESIS N9 &AS UNDERSCORE MINUS	
											&trans 	&trans 	&trans 	&trans &trans    	&kp ASTERISK 				&AS DOLLAR NUMBER_4 	 	&AS PERCENT N5 				&AS CARET NUMBER_6		&AS EQUAL PLUS 			
								&trans 		&trans 	&trans 	&trans 	&trans &trans    	&AS RIGHT_PARENTHESIS N0	&AS EXCLAMATION NUMBER_1	&AS AT_SIGN NUMBER_2 		&AS HASH NUMBER_3		&AS TILDE GRAVE				&trans
															&trans 	&trans &trans	 	&kp ESC 					&trans 						&trans 
                        >;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

				fun_layer {
					bindings = <
											&trans 	&kp F9	&kp F10	&kp F11	&kp F12   &trans &trans &trans &trans 	&bt BT_SEL 0
											&trans 	&kp F5	&kp F6	&kp F7	&kp F8   &trans &trans &trans &trans 	&bt BT_SEL 1
								&bt BT_CLR	&trans 	&kp F1	&kp F2 	&kp F3 	&kp F4   &trans &trans &trans &trans 	&bt BT_SEL 2	&bt BT_DISC
															&trans 	&trans 	&kp ESC	 &trans	&trans &trans 
            >;
        };
    };
};
                